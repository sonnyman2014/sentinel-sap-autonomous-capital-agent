    "mcp": "tsx src/mcp-server.ts --stdio",
    "blink": "tsx src/http-server.ts"
  },
  "keywords": [
    "solana",
    "oobe-protocol",
    "synapse-sap",
    "steve-capital",
    "multihopper",
    "mcp",
    "solana-actions",
    "blinks",
    "x402",
    "autonomous-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@oobe-protocol-labs/synapse-sap-sdk": "1.0.3",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.3",
    "bs58": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
